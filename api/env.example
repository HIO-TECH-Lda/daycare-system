# Server
NODE_ENV=development
PORT=3002

# Database
MONGODB_URI=mongodb://localhost:27017/your_db_name

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Required in production, and different from JWT_SECRET (refresh tokens are signed with it)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-different-from-jwt-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cloudinary (file uploads) ───────────────────────────────────────────────
# Required for avatar, children photos, pickup-person photos, report photos, and
# expense receipts. Without these, any endpoint that receives a file will return 500.
#
# Setup steps:
#   1. Create a free account at https://cloudinary.com
#   2. Open the Dashboard → copy Cloud Name, API Key, API Secret
#   3. CLOUDINARY_FOLDER_NAME is the root folder; sub-folders are created automatically:
#      sonho-de-crianca/avatars, /children, /pickup-persons, /report-photos, /receipts
#
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_NAME=sonho-de-crianca

# Frontend URL (used in email and WhatsApp links, e.g. /convite/<token>)
FRONTEND_URL=http://localhost:3000

# Public URL of this API. Photos of children are served through signed links on it
# (/api/v1/media/...). REQUIRED in production, e.g. https://api.example.co.mz
API_PUBLIC_URL=http://localhost:3002
# Optional: secret for those links (defaults to one derived from JWT_SECRET)
MEDIA_URL_SECRET=

# Browser origins allowed to call the API (comma-separated, * wildcard allowed).
# Leave empty in development to allow any origin. REQUIRED in production, e.g.:
# CORS_ORIGINS=https://app.example.co.mz,https://deploy-preview-*--sonho.netlify.app
CORS_ORIGINS=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Leave SMTP_USER / SMTP_PASS empty to disable email notifications in dev.
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
# Leave empty to disable WhatsApp notifications.
#
# Setup steps:
#   1. Create a Meta Business account → https://business.facebook.com
#   2. Add a WhatsApp Business Account (WABA) and a phone number
#   3. Create a System User with "Manage" permission → copy the access token
#   4. Get the Phone Number ID from the WhatsApp panel (not the real phone number)
#   5. Create and get approval for message templates (see docs/WHATSAPP-TEMPLATES.md)
#
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LANG=pt_BR

# WhatsApp approved template names (must match Meta Business Manager exactly)
WA_TEMPLATE_INVITE=sonho_invite
WA_TEMPLATE_WELCOME=sonho_welcome
WA_TEMPLATE_INVOICE_NEW=sonho_invoice_new
WA_TEMPLATE_INVOICE_OVERDUE=sonho_invoice_overdue
WA_TEMPLATE_INVOICE_PAID=sonho_invoice_paid
WA_TEMPLATE_DAILY_REPORT=sonho_daily_report
WA_TEMPLATE_MONTHLY_REPORT=sonho_monthly_report
WA_TEMPLATE_NEW_MESSAGE=sonho_new_message
WA_TEMPLATE_ATTENDANCE_CHECKIN=sonho_attendance_checkin
WA_TEMPLATE_ATTENDANCE_CHECKOUT=sonho_attendance_checkout
WA_TEMPLATE_PASSWORD_RESET=sonho_password_reset
WA_TEMPLATE_ENROLLMENT_RECEIVED=sonho_enrollment_received
WA_TEMPLATE_ENROLLMENT_APPROVED=sonho_enrollment_approved
