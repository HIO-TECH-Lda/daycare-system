{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cpt1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "src/templates/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/v1/jobs/mark-overdue", "schedule": "0 4 * * *" }
  ]
}
